# Contest 2026 team 393 - AI-VOX3 desktop companion (full config)
# Console over native USB-CDC (VID:PID 303A:1001).
# Reference: vendor_espressif/boards/esp32s3/esp32s3-eye

CONFIG_ARCH="xtensa"
CONFIG_ARCH_XTENSA=y
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_CONTEST2026_393_BOARD=y
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_BOARD_LOOPSPERMSEC=16717

# Dual core + 8 MB OCT PSRAM
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y

# Native USB-CDC serial console
CONFIG_ESP32S3_USBSERIAL=y
CONFIG_USBSERIAL_CONSOLE=y

# Internal SRAM (PSRAM is heap-extended by the SPIRAM driver)
CONFIG_RAM_START=0x20000000
CONFIG_RAM_SIZE=114688

# ---- SPI2 (FSPI) for LCD ----
CONFIG_ESP32S3_SPI2=y
CONFIG_ESP32S3_SPI2_MOSI_GPIO=21
CONFIG_ESP32S3_SPI2_MISO_GPIO=4
CONFIG_ESP32S3_SPI2_CLK_GPIO=17
CONFIG_ESP32S3_SPI2_CS0_GPIO=15

# ---- LCD ST7789 (240x240, RGB565) ----
CONFIG_LCD=y
CONFIG_LCD_DEV=y
CONFIG_LCD_ST7789=y
CONFIG_LCD_ST7789_XRES=240
CONFIG_LCD_ST7789_YRES=240
CONFIG_LCD_ST7789_BPP=16
CONFIG_LCD_ST7789_FREQUENCY=20000000
CONFIG_LCD_ST7789_INVCOLOR=y
CONFIG_LCD_FRAMEBUFFER=y

# ---- Buttons ----
CONFIG_INPUT_BUTTONS=y

# ---- Servo PWM (LEDC) ----
CONFIG_ESP32S3_LEDC=y
CONFIG_ESP32S3_LEDC_TIMER0=y
CONFIG_ESP32S3_LEDC_CHANNEL0=y
CONFIG_ESP32S3_LEDC_CHANNEL0_GPIO=42
CONFIG_ESP32S3_LEDC_CHANNEL0_TIMER=0
CONFIG_ESP32S3_LEDC_TIMER1=y
CONFIG_ESP32S3_LEDC_CHANNEL1=y
CONFIG_ESP32S3_LEDC_CHANNEL1_GPIO=43
CONFIG_ESP32S3_LEDC_CHANNEL1_TIMER=1

# ---- I2C for ES8311 ----
CONFIG_ESP32S3_I2C0=y
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y

# ---- NSH + builtin app ----
CONFIG_SYSTEM_NSH=y
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_READLINE=y
CONFIG_LVX_USE_DEMO_CONTEST2026_393_DESKTOP_COMPANION=y

# Scheduling / runtime
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_WAITPID=y
CONFIG_PREALLOC_TIMERS=4
CONFIG_IDLETHREAD_STACKSIZE=3072
CONFIG_INIT_STACKSIZE=3072
CONFIG_DEFAULT_TASK_STACKSIZE=4096

# Debug / diagnostics
CONFIG_DEBUG_SYMBOLS=y
CONFIG_ARCH_STACKDUMP=y
CONFIG_INTELHEX_BINARY=y
CONFIG_RAW_BINARY=y
