+/* Rewrite ALL 15 vector slots to `j <stub>`.  Slot layout measured on
+ * the run82 ELF: 6 window vectors (+0x000/040/080/0c0/100/140), levels
+ * 2-5 (+0x180/1c0/200/240), debug (+0x280), NMI (+0x2c0), kernel
+ * (+0x300), user (+0x340), double (+0x3c0).  IRAM is writable, isync
+ * flushes the prefetch queue.  Stub labels are .balign 4 so the J
+ * offsets stay 4-byte multiples. */
+
+HB_IRAM void hb_arm_exc_probe(void)
+{
+  extern uint8_t _init_start[];
+  extern void hb_exc_stub_000(void);
+  extern void hb_exc_stub_040(void);
+  extern void hb_exc_stub_080(void);
+  extern void hb_exc_stub_0c0(void);
+  extern void hb_exc_stub_100(void);
+  extern void hb_exc_stub_140(void);
+  extern void hb_exc_stub_180(void);
+  extern void hb_exc_stub_1c0(void);
+  extern void hb_exc_stub_200(void);
+  extern void hb_exc_stub_240(void);
+  extern void hb_exc_stub_280(void);
+  extern void hb_exc_stub_2c0(void);
+  extern void hb_exc_stub_300(void);
+  extern void hb_exc_stub_340(void);
+  extern void hb_exc_stub_3c0(void);
+  static void * const hb_exc_stubs[15] =
+    {
+      hb_exc_stub_000, hb_exc_stub_040, hb_exc_stub_080,
+      hb_exc_stub_0c0, hb_exc_stub_100, hb_exc_stub_140,
+      hb_exc_stub_180, hb_exc_stub_1c0, hb_exc_stub_200,
+      hb_exc_stub_240, hb_exc_stub_280, hb_exc_stub_2c0,
+      hb_exc_stub_300, hb_exc_stub_340, hb_exc_stub_3c0
+    };
+  static const uint16_t hb_exc_offs[15] =
+    {
+      0x000u, 0x040u, 0x080u, 0x0c0u, 0x100u, 0x140u, 0x180u, 0x1c0u,
+      0x200u, 0x240u, 0x280u, 0x2c0u, 0x300u, 0x340u, 0x3c0u
+    };
+  extern void hb_exc_stub_panic(void);
+  extern void _xtensa_panic(void);
+  volatile uint32_t *slot;
+  volatile uint32_t *panicw;
+  uint32_t pc;
+  int32_t off;
+  uint32_t instr;
+  int i;
+
+  for (i = 0; i < 15; i++)
+    {
+      slot = (volatile uint32_t *)
+        ((uint32_t)_init_start + hb_exc_offs[i]);
+      pc = (uint32_t)slot;
+      off = (int32_t)((uint8_t *)hb_exc_stubs[i]
+                      - (uint8_t *)pc - 4);
+      instr = (((uint32_t)off >> 2) & 0x3ffffu) << 6 | 0x06u;
+
+      *slot = instr;
+    }
+
+  /* v8: also hook the panic funnel.  Every storm path ends in
+   * _xtensa_panic (the double vector calls it with cause=2 in a2, the
+   * level-1 handlers call it too).  Overwrite its first word with a j
+   * to the panic stub (id 16); the common body then records a0 = the
+   * call site inside the handler, a1 = stack, a2 = cause. */
+
+  panicw = (volatile uint32_t *)(void *)_xtensa_panic;
+  pc = (uint32_t)panicw;
+  off = (int32_t)((uint8_t *)hb_exc_stub_panic - (uint8_t *)pc - 4);
+  instr = (((uint32_t)off >> 2) & 0x3ffffu) << 6 | 0x06u;
+  *panicw = instr;
+
+  __asm__ __volatile__ ("isync\n" ::: "memory");
+
+  /* v8 audit: which table is live and did our writes actually stick? */
+
+  __asm__ __volatile__ ("rsr.vecbase %0\n" : "=r" (pc));
+  hb_arm_audit[0] = pc;
+  hb_arm_audit[1] = ((volatile uint32_t *)
+                     ((uint32_t)_init_start + 0x3c0))[0];
+  hb_arm_audit[2] = ((volatile uint32_t *)
+                     ((uint32_t)_init_start + 0x340))[0];
+  hb_arm_audit[3] = panicw[0];
+}
