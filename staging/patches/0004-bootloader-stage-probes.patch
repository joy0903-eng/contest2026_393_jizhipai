+/* v9: the runtime rewrite loop is GONE (runs 83/84/85: the slot stores
+ * are silently dropped, and v8's panic-hook store faults outright).
+ * The vectors are hooked at link time by the xtensa_vectors.S hunk of
+ * this patch.  This probe now only reads back the live vecbase as a
+ * per-boot health check for the ARM line: nonzero = the dump/arm path
+ * ran on the app vector table. */
+
+HB_IRAM void hb_arm_exc_probe(void)
+{
+  uint32_t vb;
+
+  __asm__ __volatile__ ("rsr.vecbase %0\n" : "=r" (vb));
+  hb_arm_audit[0] = vb;
+}
