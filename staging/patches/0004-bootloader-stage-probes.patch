+  __real_bootloader_clock_configure();
+  hb_mark('6', '<');
+}
+
+HB_IRAM void __wrap_bootloader_console_init(void)
+{
+  hb_mark('7', '>');
+  __real_bootloader_console_init();
+  hb_mark('7', '<');
+}
+
+/* Stage 8 (banner) is already wrapped upstream (Booting-NuttX banner).
+ * Stages 9-H run after cache/mmu init; their exit markers may be lost if
+ * mmu_hal_unmap_all drops the IROM mapping (harmless for diagnosis). */
+
+HB_IRAM void __wrap_cache_hal_init(void)
+{
