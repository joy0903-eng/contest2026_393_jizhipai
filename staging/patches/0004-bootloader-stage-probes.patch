+/* ---- v7: ALL-vector-slot capture (run83 lesson) ----------------------
+ * v6 hooked ONLY the user-exception slot (+0x340); run83 proved it never
+ * fires (35 boots, hb_exc_area stayed zero) -- so the primary exception
+ * goes through a WINDOW vector (+0x000..0x140), a level>=2 slot
+ * (+0x180..0x240), or the live vecbase is not our table at all.  v7
+ * rewrites ALL 15 vector slots to jump into per-slot stubs
+ * (movi a6,<id>; j common).  The common body stores an 8-word record
+ * into .bss hb_exc_area: slot-id, EXCCAUSE, EXCVADDR, EPC1, EXCSAVE1,
+ * PS, DEPC and -- decisive -- the VECBASE seen at exception time.  It
+ * then spins (no context save -> no storm); TG0WDT resets ~8 s later;
+ * DRAM survives the soft reset, so the next boot dumps the record
+ * before re-arming.  A guard (slot-id already nonzero -> just spin)
+ * keeps a nested double-strike from overwriting the primary capture.
+ * dump_prev prints an EXC-none line when the record is clean, proving
+ * the arm path ran.  Debug-only; reverted with the rest of 0004. */
+
+/* Capture record: [0]=slot id (1..15), [1]=EXCCAUSE, [2]=EXCVADDR,
+ * [3]=EPC1, [4]=EXCSAVE1, [5]=PS, [6]=DEPC, [7]=vecbase at exception.
+ * Plain .bss/DRAM (data only); the bss-clearing init_mem stage never
+ * runs because we die before it, so values persist across boots. */
+
+uint32_t hb_exc_area[12];
+
+/* Arm-time audit, written every boot by hb_arm_exc_probe and dumped
+ * before the capture record: [0]=live vecbase, [1]=double-slot word
+ * AFTER the rewrite, [2]=user-slot word AFTER the rewrite, [3]=first
+ * word of _xtensa_panic AFTER the hook.  Run83/84 lesson: the slots
+ * never fired -- this line proves (a) which table the CPU is on and
+ * (b) whether our IRAM writes actually stick (PMS write-protect?). */
+
+uint32_t hb_arm_audit[4];
+
+HB_IRAM static void hb_fmt_hex(char *p, uint32_t v)
+{
+  int i;
+
+  for (i = 7; i >= 0; i--)
+    {
+      uint32_t d = v & 15;
+
+      p[i] = (d < 10) ? ('0' + d) : ('a' + d - 10);
+      v >>= 4;
+    }
+}
+
+HB_IRAM static void hb_put_tag(char **pp, char c0, char c1, char c2,
+                               char c3, char c4, char c5, char c6,
+                               char c7)
+{
+  char *p = *pp;
+
+  *p++ = '[';  *p++ = 'H';  *p++ = 'B';  *p++ = ']';  *p++ = ' ';
+  *p++ = c0;   *p++ = c1;   *p++ = c2;   *p++ = c3;
+  *p++ = c4;   *p++ = c5;   *p++ = c6;   *p++ = c7;
+
+  *pp = p;
+}
+
+HB_IRAM void hb_dump_prev(void)
+{
+  char buf[136];
+  char *p = buf;
+  int i;
+
+  /* audit line: always printed, proves the arm path ran every boot */
+  p = buf;
+  hb_put_tag(&p, 'A', 'R', 'M', ' ', ' ', ' ', ' ', ' ');
+  for (i = 0; i < 4; i++)
+    {
+      hb_fmt_hex(p, hb_arm_audit[i]);
+      p += 8;
+      *p++ = (i == 3) ? '\n' : ' ';
+    }
+  *p = '\0';
+  ets_printf(buf);
+
+  if (hb_exc_area[0] == 0)
+    {
+      p = buf;
+      hb_put_tag(&p, 'E', 'X', 'C', ' ', 'n', 'o', 'n', 'e');
+      *p++ = '\n';
+      *p = '\0';
+      ets_printf(buf);
+      return;
+    }
+
+  p = buf;
+  hb_put_tag(&p, 'E', 'X', 'C', ' ', ' ', ' ', ' ', ' ');
+  for (i = 0; i < 12; i++)
+    {
+      hb_fmt_hex(p, hb_exc_area[i]);
+      p += 8;
+      *p++ = (i == 11) ? '\n' : ' ';
+    }
+  *p = '\0';
+  ets_printf(buf);
+}
+
+/* No naked attribute on Xtensa GCC -> file-level asm so the emitted code
+ * is exactly what is written (zero prologue; runs with unknown
+ * stack/window state).  One 6-byte stub per vector slot carries the
+ * slot id in a6; the common body does the capture.  The literal pool is
+ * .balign 4 (run83 asm lesson: l32r offsets must be 4-byte multiples
+ * relative to (PC+3)&~3).  The guard reads hb_exc_area[0] first and
+ * skips the store when a capture already happened (nested double
+ * exception must not erase the primary record). */
+
+void hb_exc_common(void);
+
+__asm__(
+  ".pushsection .iram1, \"ax\", @progbits\n"
+  "  .balign 4\n"
+  "  .globl hb_exc_common\n"
+  "  .hidden hb_exc_common\n"
+  "hb_exc_common:\n"
+  "  j 8f\n"
+  "  .balign 4\n"
+  "9: .word hb_exc_area\n"
+  "8: l32r a3, 9b\n"
+  "  mov a4, a0\n"
+  "  mov a5, a2\n"
+  "  l32i a2, a3, 0\n"
+  "  bnez a2, 7f\n"
