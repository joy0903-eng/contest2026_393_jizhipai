diff --git a/arch/xtensa/src/esp32s3/esp32s3_start.c b/arch/xtensa/src/esp32s3/esp32s3_start.c
--- a/arch/xtensa/src/esp32s3/esp32s3_start.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_start.c
@@ -475,6 +475,37 @@
   __asm__ __volatile__ ("wsr %0, vecbase\n"::"r" (_init_start));
 
   ets_printf("[HB] @A vecbase set\n");
+
+  /* v5 root-cause fix (runs 76/78/79/80): the ROM hands control to
+   * __start with a stack whose usable depth below the entry frame is
+   * only ~100 bytes.  bootloader_init() nests four more call frames and
+   * ets_printf() needs internal stack on top; the first write beyond the
+   * shallow region faults, the exception handling chain faults again
+   * (double exception), and the TG0WDT finally bites inside the storm.
+   *
+   * Switch to the IDLE task stack (g_idlestack, .noinit, 16-byte
+   * aligned) for the whole boot sequence.  This is transparent to the
+   * generated code: locals are addressed relative to a1, so they are
+   * simply re-homed on the new stack, and __start never returns to the
+   * old frame.  The real startup code installs its own task stacks
+   * later; the IDLE stack is re-initialized when the IDLE task starts. */
+  {
+    uint32_t sp_new = (uint32_t)g_idlestack +
+                      IDLETHREAD_STACKWORDS * sizeof(uint32_t) - 64;
+
+    __asm__ __volatile__ ("mov a1, %0\n" :: "r" (sp_new));
+  }
+
+  /* v6: report any exception captured by the previous boot cycle, then
+   * re-arm the exception-slot probe.  See esp32s3_boot_hb_wrap.c. */
+  {
+    extern void hb_arm_exc_probe(void);
+    extern void hb_dump_prev(void);
+
+    hb_dump_prev();
+    hb_arm_exc_probe();
+  }
+
   if (bootloader_init() != 0)
     {
       ets_printf("Hardware init failed, aborting\n");
