Wrap bootloader_init() sub-stages with IRAM [HB] probes + ROM stack switch (v5)

arch/xtensa/src/esp32s3/esp32s3_boot_hb_wrap.c (new, rewritten)
arch/xtensa/src/esp32s3/hal.mk
arch/xtensa/src/esp32s3/esp32s3_start.c

WHY v5 (root cause found)
-------------------------
Runs 76/78/79/80 all died at the same stack depth: __start + wrap0 +
hb_mark need ~106 bytes below the ROM-provided stack pointer (>0 printed
OK), and the very first deeper frame (real bootloader_init, ~S-128)
faulted.  The SIMPLE_BOOT path in esp32s3_start.c never installs a real
stack, and the ROM-provided one has only ~100 usable bytes.  The fault
kicks off an exception storm (Saved PC observed inside
_double_exception_vector and _xtensa_context_save) that the TG0WDT
finally kills.

v5 changes:
- esp32s3_start.c: switch a1 to g_idlestack (the IDLE task stack lives
  in .noinit) right after wsr.vecbase, before bootloader_init().  This
  is transparent to the generated code (locals are a1-relative; the
  function never returns to the old frame).
- boot-stage heartbeat probes kept (v2 mechanics): section-.iram1
  wrappers + -mtext-section-literals, no sections.ld edit (run#77
  lesson: CI tree sections.ld drifts, hunk placement unreliable).

Debug-only change; probes to be reverted once boot is verified.

diff --git a/arch/xtensa/src/esp32s3/esp32s3_boot_hb_wrap.c b/arch/xtensa/src/esp32s3/esp32s3_boot_hb_wrap.c
--- /dev/null
+++ b/arch/xtensa/src/esp32s3/esp32s3_boot_hb_wrap.c
@@ -0,0 +1,329 @@
+/****************************************************************************
+ * arch/xtensa/src/esp32s3/esp32s3_boot_hb_wrap.c
+ *
+ * Debug-only boot-stage heartbeat probes (SIMPLE_BOOT), v2.
+ *
+ * On real hardware the SIMPLE_BOOT startup dies inside bootloader_init()
+ * before its banner is printed (run#76/77: the [HB] @A vecbase-set marker is
+ * the last visible output, then silence, then the TG0WDT reset loop).  This
+ * file wraps bootloader_init() itself plus every cross-object sub-stage via
+ * -Wl,--wrap (see hal.mk): each wrapper prints an [HB] entry marker ( >N )
+ * before calling the real function and an [HB] exit marker ( <N ) after it
+ * returns (N = stage id below).  The last marker visible on the console
+ * names the failing stage.
+ *
+ * PLACEMENT (v2 -- run#77 lesson): flash I-cache/MMU mapping is NOT alive
+ * when bootloader_init() runs, so every function in this file is forced
+ * into .iram1 by attribute (collected by the platform wildcard
+ * *(.iram1 .iram1.*) in esp32s3_sections.ld) and hal.mk adds
+ * -mtext-section-literals so the l32r literal pool of each function is
+ * emitted inside its own .text section and follows it into .iram1.  No
+ * string literals are used anywhere: the marker buffer is built on the
+ * stack from character constants (rodata lives in DROM).
+ *
+ * STAGE LIST
+ *   0 bootloader_init (entry)                  9 cache_hal_init
+ *   1 bootloader_ana_super_wdt_reset_config    A mmu_hal_init
+ *   2 bootloader_ana_bod_reset_config          B bootloader_flash_update_id
+ *   3 bootloader_ana_clock_glitch_reset_config C bootloader_flash_xmc_startup
+ *   4 bootloader_init_mem                      D bootloader_read_bootloader_header
+ *   5 bootloader_clear_bss_section             E bootloader_check_bootloader_validity
+ *   6 bootloader_clock_configure               F bootloader_init_spi_flash
+ *   7 bootloader_console_init                  G bootloader_config_wdt
+ *   (8 = upstream Booting-NuttX banner)        H bootloader_enable_random
+ *
+ ****************************************************************************/
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define HB_IRAM __attribute__((section(".iram1")))
+
+/* ets_printf is a ROM function: always mapped and reaching the console
+ * through the same channel the ROM reset banner uses.
+ */
+
+extern int ets_printf(const char *fmt, ...);
+
+/* Real implementations live in the esp-hal-3rdparty bootloader objects;
+ * the linker resolves __real_* when the matching --wrap flag is active.
+ * esp_err_t is int (matching IDF), spelled plain here on purpose so this
+ * file needs no esp-hal headers.
+ */
+
+extern int  __real_bootloader_init(void);
+extern void __real_bootloader_init_mem(void);
+extern void __real_bootloader_clear_bss_section(void);
+extern void __real_bootloader_clock_configure(void);
+extern void __real_bootloader_console_init(void);
+extern void __real_cache_hal_init(void);
+extern void __real_mmu_hal_init(void);
+extern void __real_bootloader_flash_update_id(void);
+extern int  __real_bootloader_flash_xmc_startup(void);
+extern int  __real_bootloader_read_bootloader_header(void);
+extern int  __real_bootloader_check_bootloader_validity(void);
+extern int  __real_bootloader_init_spi_flash(void);
+extern void __real_bootloader_config_wdt(void);
+extern void __real_bootloader_enable_random(void);
+
+/* Build the [HB] marker (dir + stage + newline) on the stack (DRAM):
+ * no .rodata / DROM access anywhere in this file.
+ */
+
+HB_IRAM static void hb_mark(char stage, char dir)
+{
+  char buf[10];
+
+  buf[0] = '[';
+  buf[1] = 'H';
+  buf[2] = 'B';
+  buf[3] = ']';
+  buf[4] = ' ';
+  buf[5] = dir;
+  buf[6] = stage;
+  buf[7] = '\n';
+  buf[8] = '\0';
+  ets_printf(buf);
+}
+
+/* Stage 0: proves execution reached bootloader_init() at all.  Stages 1-7
+ * run before the banner -- this is the window where the first exception
+ * is currently known to fire. */
+
+HB_IRAM int __wrap_bootloader_init(void)
+{
+  int ret;
+
+  hb_mark('0', '>');
+  ret = __real_bootloader_init();
+  hb_mark('0', '<');
+  return ret;
+}
+
+/* Stages 1-3 (v4): STUBS.  The markers prove the call8 + entry path is
+ * healthy; the real bodies are deliberately NOT called -- run#79 proved
+ * the primary exception fires inside them (exception storm confirmed by
+ * Saved PC inside _double_exception_vector).  The ana config is
+ * second-stage-bootloader defensive work and is safe to skip here. */
+
+HB_IRAM void __wrap_bootloader_ana_super_wdt_reset_config(bool enable)
+{
+  (void)enable;
+  hb_mark('1', '>');
+}
+
+HB_IRAM void __wrap_bootloader_ana_bod_reset_config(bool enable)
+{
+  (void)enable;
+  hb_mark('2', '>');
+}
+
+HB_IRAM void __wrap_bootloader_ana_clock_glitch_reset_config(bool enable)
+{
+  (void)enable;
+  hb_mark('3', '>');
+}
+
+HB_IRAM void __wrap_bootloader_init_mem(void)
+{
+  hb_mark('4', '>');
+  __real_bootloader_init_mem();
+  hb_mark('4', '<');
+}
+
+HB_IRAM void __wrap_bootloader_clear_bss_section(void)
+{
+  hb_mark('5', '>');
+  __real_bootloader_clear_bss_section();
+  hb_mark('5', '<');
+}
+
+HB_IRAM void __wrap_bootloader_clock_configure(void)
+{
+  hb_mark('6', '>');
+  __real_bootloader_clock_configure();
+  hb_mark('6', '<');
+}
+
+HB_IRAM void __wrap_bootloader_console_init(void)
+{
+  hb_mark('7', '>');
+  __real_bootloader_console_init();
+  hb_mark('7', '<');
+}
+
+/* Stage 8 (banner) is already wrapped upstream (Booting-NuttX banner).
+ * Stages 9-H run after cache/mmu init; their exit markers may be lost if
+ * mmu_hal_unmap_all drops the IROM mapping (harmless for diagnosis). */
+
+HB_IRAM void __wrap_cache_hal_init(void)
+{
+  hb_mark('9', '>');
+  __real_cache_hal_init();
+  hb_mark('9', '<');
+}
+
+HB_IRAM void __wrap_mmu_hal_init(void)
+{
+  hb_mark('A', '>');
+  __real_mmu_hal_init();
+  hb_mark('A', '<');
+}
+
+HB_IRAM void __wrap_bootloader_flash_update_id(void)
+{
+  hb_mark('B', '>');
+  __real_bootloader_flash_update_id();
+  hb_mark('B', '<');
+}
+
+HB_IRAM int __wrap_bootloader_flash_xmc_startup(void)
+{
+  int ret;
+
+  hb_mark('C', '>');
+  ret = __real_bootloader_flash_xmc_startup();
+  hb_mark('C', '<');
+  return ret;
+}
+
+HB_IRAM int __wrap_bootloader_read_bootloader_header(void)
+{
+  int ret;
+
+  hb_mark('D', '>');
+  ret = __real_bootloader_read_bootloader_header();
+  hb_mark('D', '<');
+  return ret;
+}
+
+HB_IRAM int __wrap_bootloader_check_bootloader_validity(void)
+{
+  int ret;
+
+  hb_mark('E', '>');
+  ret = __real_bootloader_check_bootloader_validity();
+  hb_mark('E', '<');
+  return ret;
+}
+
+HB_IRAM int __wrap_bootloader_init_spi_flash(void)
+{
+  int ret;
+
+  hb_mark('F', '>');
+  ret = __real_bootloader_init_spi_flash();
+  hb_mark('F', '<');
+  return ret;
+}
+
+HB_IRAM void __wrap_bootloader_config_wdt(void)
+{
+  hb_mark('G', '>');
+  __real_bootloader_config_wdt();
+  hb_mark('G', '<');
+}
+
+HB_IRAM void __wrap_bootloader_enable_random(void)
+{
+  hb_mark('H', '>');
+  __real_bootloader_enable_random();
+  hb_mark('H', '<');
+}
+
+/* ---- v6: primary-exception capture (run82 lesson) -------------------
+ * Runs 76/78/79/80/82 all die after >0 with code placement, image
+ * content, window depth and stack proven clean (flash == ELF verified
+ * byte-exact on run82).  The only remaining unknown is the CAUSE of the
+ * primary exception, which the storm (double exception -> panic) masks.
+ * We rewrite the user-exception vector slot (vecbase+0x340) to jump into
+ * a probe that stores EXCCAUSE/EXCVADDR/EPC1/EXCSAVE1 into DRAM and then
+ * spins (no context save -> no storm).  TG0WDT resets ~8 s later; DRAM
+ * survives a soft reset, so the next boot prints the captured cause
+ * before re-arming.  Debug-only; reverted with the rest of 0004. */
+
+/* Storage for the captured registers (plain .bss/DRAM -- data only, and
+ * TG0WDT soft resets preserve it; the bss-clearing init_mem stage never
+ * runs because we die before it, so values persist across boot cycles). */
+
+uint32_t hb_exc_area[4];
+
+HB_IRAM static void hb_fmt_hex(char *p, uint32_t v)
+{
+  int i;
+
+  for (i = 7; i >= 0; i--)
+    {
+      uint32_t d = v & 15;
+
+      p[i] = (d < 10) ? ('0' + d) : ('a' + d - 10);
+      v >>= 4;
+    }
+}
+
+HB_IRAM void hb_dump_prev(void)
+{
+  char buf[48];
+  char *p = buf;
+
+  if (hb_exc_area[0] == 0 && hb_exc_area[2] == 0)
+    {
+      return;
+    }
+
+  *p++ = '[';  *p++ = 'H';  *p++ = 'B';  *p++ = ']';  *p++ = ' ';
+  *p++ = 'E';  *p++ = 'X';  *p++ = 'C';  *p++ = ' ';
+  hb_fmt_hex(p, hb_exc_area[0]);  p += 8;  *p++ = ' ';
+  hb_fmt_hex(p, hb_exc_area[1]);  p += 8;  *p++ = ' ';
+  hb_fmt_hex(p, hb_exc_area[2]);  p += 8;  *p++ = ' ';
+  hb_fmt_hex(p, hb_exc_area[3]);  p += 8;
+  *p++ = '\n';
+  *p = '\0';
+  ets_printf(buf);
+}
+
+/* Naked probe: capture the four exception registers, then spin.  Runs
+ * with unknown stack/window state, so it must have NO prologue at all
+ * (Xtensa GCC has no naked attribute) -- written as file-level asm in
+ * .iram1, so the emitted code is exactly the instruction sequence below. */
+
+void hb_exc_probe(void);
+
+__asm__(
+  ".pushsection .iram1, \"ax\", @progbits\n"
+  "  .globl hb_exc_probe\n"
+  "  .hidden hb_exc_probe\n"
+  "hb_exc_probe:\n"
+  "  j 8f\n"
+  "  .balign 4\n"
+  "9: .word hb_exc_area\n"
+  "8: rsr.exccause a2\n"
+  "  l32r a3, 9b\n"
+  "  s32i a2, a3, 0\n"
+  "  rsr.excvaddr a2\n"
+  "  s32i a2, a3, 4\n"
+  "  rsr.epc1 a2\n"
+  "  s32i a2, a3, 8\n"
+  "  rsr.excsave1 a2\n"
+  "  s32i a2, a3, 12\n"
+  "7: j 7b\n"
+  ".popsection\n"
+);
+
+/* Rewrite the user-exception slot to `j hb_exc_probe`.  The slot layout
+ * was verified in the ELF: vecbase+0x340 = _user_exception_vector
+ * (wsr.excsave1 a0; call0 _xtensa_user_handler).  IRAM is writable and
+ * isync flushes the prefetch queue; no cache is involved. */
+
+HB_IRAM void hb_arm_exc_probe(void)
+{
+  extern uint8_t _init_start[];
+
+  volatile uint32_t *slot = (volatile uint32_t *)((uint32_t)_init_start + 0x340);
+  uint32_t pc = (uint32_t)slot;
+  int32_t off = (int32_t)((uint8_t *)hb_exc_probe - (uint8_t *)pc - 4);
+  uint32_t instr = (((uint32_t)off >> 2) & 0x3ffffu) << 6 | 0x06u;
+
+  *slot = instr;
+  __asm__ __volatile__ ("isync\n" ::: "memory");
+}
diff --git a/arch/xtensa/src/esp32s3/hal.mk b/arch/xtensa/src/esp32s3/hal.mk
