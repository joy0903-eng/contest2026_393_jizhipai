+/* ---- v9: SOURCE-LEVEL vector hook (runs 83/84/85 lesson) --------------
+ * Runtime IRAM rewrites are dead here: v6 (user slot only) and v7 (all
+ * 15 slots) never captured anything (35 boots each), yet the storm still
+ * runs the ORIGINAL handlers (Saved PC inside _xtensa_context_save) --
+ * so the slot stores never took effect.  v8 additionally hooked
+ * _xtensa_panic at runtime: the boot then died inside the arm probe
+ * itself (audit never written, >0 gone) -- THAT store faults outright
+ * while the slot stores are silently dropped.  Conclusion: no runtime
+ * writes to the vector region, ever.  v9 moves the hook to link time:
+ * this patch also rewrites arch/xtensa/src/common/xtensa_vectors.S so
+ * the level2/level3/nmi/kernel/user vectors call hb_exc_stub_180/1c0/
+ * 2c0/300/340 and the double-exception vector calls hb_exc_stub_3c0
+ * directly.  The capture stubs below are unchanged; the window vectors
+ * are left untouched (they are the hot path of normal windowed-ABI
+ * execution).  Debug-only; reverted with the rest of 0004. */
+
+/* Capture record: [0]=slot id (1..15), [1]=EXCCAUSE, [2]=EXCVADDR,
+ * [3]=EPC1, [4]=EXCSAVE1, [5]=PS, [6]=DEPC, [7]=vecbase at exception.
+ * Plain .bss/DRAM (data only); the bss-clearing init_mem stage never
+ * runs because we die before it, so values persist across boots. */
+
+uint32_t hb_exc_area[12];
+
+/* Arm-time audit, written every boot by hb_arm_exc_probe and dumped
+ * before the capture record: [0]=live vecbase (proves the CPU is on
+ * the app vector table and that the dump/arm path ran); [1..3] were
+ * used by the v8 write-back experiment and stay zero in v9. */
+
+uint32_t hb_arm_audit[4];
+
+HB_IRAM static void hb_fmt_hex(char *p, uint32_t v)
+{
+  int i;
+
+  for (i = 7; i >= 0; i--)
+    {
+      uint32_t d = v & 15;
+
+      p[i] = (d < 10) ? ('0' + d) : ('a' + d - 10);
+      v >>= 4;
+    }
+}
+
+HB_IRAM static void hb_put_tag(char **pp, char c0, char c1, char c2,
+                               char c3, char c4, char c5, char c6,
+                               char c7)
+{
+  char *p = *pp;
+
+  *p++ = '[';  *p++ = 'H';  *p++ = 'B';  *p++ = ']';  *p++ = ' ';
+  *p++ = c0;   *p++ = c1;   *p++ = c2;   *p++ = c3;
+  *p++ = c4;   *p++ = c5;   *p++ = c6;   *p++ = c7;
+
+  *pp = p;
+}
+
+HB_IRAM void hb_dump_prev(void)
+{
+  char buf[136];
+  char *p = buf;
+  uint32_t id = hb_exc_area[0];
+  int i;
+
+  /* audit line: always printed, proves the arm path ran every boot */
+  p = buf;
+  hb_put_tag(&p, 'A', 'R', 'M', ' ', ' ', ' ', ' ', ' ');
+  for (i = 0; i < 4; i++)
+    {
+      hb_fmt_hex(p, hb_arm_audit[i]);
+      p += 8;
+      *p++ = (i == 3) ? '\n' : ' ';
+    }
+  *p = '\0';
+  ets_printf(buf);
+
+  /* Print the capture record only when the commit marker is a real slot
+   * id (1..16); cold-boot .bss garbage would otherwise print as an EXC
+   * line.  The bss-clearing bootloader stage never runs in this debug
+   * configuration, so after the dump the record is re-armed to zero:
+   * the asm guard (bnez on the marker) then lets exactly one capture
+   * happen per boot. */
+  if (id >= 1 && id <= 16)
+    {
+      p = buf;
+      hb_put_tag(&p, 'E', 'X', 'C', ' ', ' ', ' ', ' ', ' ');
+      for (i = 0; i < 12; i++)
+        {
+          hb_fmt_hex(p, hb_exc_area[i]);
+          p += 8;
+          *p++ = (i == 11) ? '\n' : ' ';
+        }
+      *p = '\0';
+      ets_printf(buf);
+    }
+  else
+    {
+      p = buf;
+      hb_put_tag(&p, 'E', 'X', 'C', ' ', 'n', 'o', 'n', 'e');
+      *p++ = '\n';
+      *p = '\0';
+      ets_printf(buf);
+    }
+
+  hb_exc_area[0] = 0;
+}
+
+/* No naked attribute on Xtensa GCC -> file-level asm so the emitted code
+ * is exactly what is written (zero prologue; runs with unknown
+ * stack/window state).  One 6-byte stub per vector slot carries the
+ * slot id in a6; the common body does the capture.  The literal pool is
+ * .balign 4 (run83 asm lesson: l32r offsets must be 4-byte multiples
+ * relative to (PC+3)&~3).  The guard reads hb_exc_area[0] first and
+ * skips the store when a capture already happened (nested double
+ * exception must not erase the primary record). */
+
+void hb_exc_common(void);
+
+__asm__(
+  ".pushsection .iram1, \"ax\", @progbits\n"
+  "  .balign 4\n"
+  "  .globl hb_exc_common\n"
+  "  .hidden hb_exc_common\n"
+  "hb_exc_common:\n"
+  "  j 8f\n"
+  "  .balign 4\n"
+  "9: .word hb_exc_area\n"
+  "8: l32r a3, 9b\n"
+  "  mov a4, a0\n"
+  "  mov a5, a2\n"
+  "  l32i a2, a3, 0\n"
+  "  bnez a2, 7f\n"
+  "  s32i a4, a3, 32\n"
+  "  s32i a1, a3, 36\n"
+  "  s32i a5, a3, 40\n"
+  "  rsr.exccause a2\n"
+  "  s32i a2, a3, 4\n"
+  "  rsr.excvaddr a2\n"
+  "  s32i a2, a3, 8\n"
+  "  rsr.epc1 a2\n"
+  "  s32i a2, a3, 12\n"
+  "  rsr.excsave1 a2\n"
+  "  s32i a2, a3, 16\n"
+  "  rsr.ps a2\n"
+  "  s32i a2, a3, 20\n"
+  "  rsr.depc a2\n"
+  "  s32i a2, a3, 24\n"
+  "  s32i a6, a3, 0\n"
+  "  rsr.vecbase a2\n"
+  "  s32i a2, a3, 28\n"
+  "7: j 7b\n"
+  "  .balign 4\n"
+  "  .globl hb_exc_stub_000\n"
+  "  .hidden hb_exc_stub_000\n"
+  "hb_exc_stub_000:\n"
+  "  movi.n a6, 1\n"
+  "  nop.n\n"
+  "  j hb_exc_common\n"
+  "  .balign 4\n"
+  "  .globl hb_exc_stub_040\n"
+  "  .hidden hb_exc_stub_040\n"
