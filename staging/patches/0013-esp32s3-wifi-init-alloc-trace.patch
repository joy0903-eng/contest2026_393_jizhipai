+/* -------------------------------------------------------------------------
+ * AI-VOX3 Wi-Fi init forensics (run#139)
+ *
+ * esp32s3_wlan_sta_initialize() fails with -12 (-ENOMEM) and the pre-compiled
+ * IDF Wi-Fi library gives no clue which internal allocation fails: its logs
+ * are dropped by esp_log_writev_wrapper() (max_level = ESP_LOG_NONE unless
+ * CONFIG_DEBUG_WIRELESS_* is defined, and that symbol exists in no Kconfig).
+ * Every allocation the library performs goes through the wifi_osi_funcs_t
+ * callbacks below, so we trace them all while esp_wifi_init() runs.
+ * -------------------------------------------------------------------------
+ */
+
+static volatile int g_wifi_alloc_trace;
+
+#define WIFI_ALLOC_TRACE(fmt, ...) \
+  do \
+    { \
+      if (g_wifi_alloc_trace) \
+        { \
+          ets_printf("[WA] " fmt "\n", ##__VA_ARGS__); \
+        } \
+    } \
+  while (0)
+
