#
# Kconfig — Board configuration for emakefun AI-VOX3 (ESP32-S3-R8)
#
# Follows the OpenVela vendor-board convention (see esp32s3-eye):
# board options are wrapped in `if ARCH_BOARD_CUSTOM` because vendor
# boards are selected via ARCH_BOARD_CUSTOM + ARCH_BOARD_CUSTOM_DIR.
#
# Pin defaults mirror board.h / the porting plan appendix B. These can
# be overridden in menuconfig.
#

if ARCH_BOARD_CUSTOM

menu "AI-VOX3 Board Settings"

comment "All default pin values are sourced from the AI-VOX3 knowledge base."

config AI_VOX3_SERVO
	bool "Enable servo (LEDC PWM) support"
	default n
	---help---
		Requires CONFIG_ESP32S3_LEDC to be enabled in the defconfig.

config AI_VOX3_WS2812
	bool "Enable WS2812 RGB LED (RMT) support"
	default n
	---help---
		Requires CONFIG_ESP32S3_RMT to be enabled in the defconfig.

config AI_VOX3_BUTTONS
	bool "Enable on-board buttons (input GPIO) support"
	depends on ESP32S3_GPIO_IRQ
	default n
	---help---
		Requires CONFIG_ESP32S3_GPIO_IRQ to be enabled in the defconfig.
		(The buttons driver attaches its own GPIO ISRs via ESP32S3_PIN2IRQ
		and does not use the generic INPUT_BUTTONS framework.)

config AI_VOX3_LCD_MOSI
	int "LCD MOSI (FSPI data) GPIO"
	default 21

config AI_VOX3_LCD_SCL
	int "LCD SCL (FSPI clock) GPIO"
	default 17

config AI_VOX3_LCD_DC
	int "LCD DC GPIO"
	default 14

config AI_VOX3_LCD_CS
	int "LCD CS GPIO"
	default 15

config AI_VOX3_LCD_BL
	int "LCD backlight GPIO"
	default 16

config AI_VOX3_LCD_RST
	int "LCD reset GPIO (-1 if not connected)"
	default -1

config AI_VOX3_ES8311_I2C_SCL
	int "ES8311 I2C SCL GPIO"
	default 12

config AI_VOX3_ES8311_I2C_SDA
	int "ES8311 I2C SDA GPIO"
	default 13

config AI_VOX3_ES8311_I2C_ADDR
	int "ES8311 I2C address"
	default 24

config AI_VOX3_I2S_MCLK
	int "I2S MCLK GPIO"
	default 11

config AI_VOX3_I2S_BCLK
	int "I2S BCLK GPIO"
	default 10

config AI_VOX3_I2S_WS
	int "I2S WS/LRCK GPIO"
	default 9

config AI_VOX3_I2S_DOUT
	int "I2S DOUT/ASDOUT GPIO"
	default 8

config AI_VOX3_I2S_DIN
	int "I2S DIN/DSDIN GPIO"
	default 7

config AI_VOX3_SERVO0_GPIO
	int "Servo 0 (PAN/TILT) GPIO"
	default 42

config AI_VOX3_SERVO1_GPIO
	int "Servo 1 GPIO"
	default 43

config AI_VOX3_SERVO2_GPIO
	int "Servo 2 GPIO"
	default 44

config AI_VOX3_SERVO3_GPIO
	int "Servo 3 GPIO"
	default 48

config AI_VOX3_WS2812_GPIO
	int "WS2812 RGB LED GPIO"
	default 41

config AI_VOX3_SD_CMD_GPIO
	int "SD CMD GPIO"
	default 38

config AI_VOX3_SD_CLK_GPIO
	int "SD CLK GPIO"
	default 39

config AI_VOX3_SD_DAT0_GPIO
	int "SD DAT0 GPIO"
	default 40

config AI_VOX3_BTN_A_GPIO
	int "Button A GPIO"
	default 46

config AI_VOX3_BTN_B_GPIO
	int "Button B GPIO"
	default 45

config AI_VOX3_BTN_BOOT_GPIO
	int "Button BOOT GPIO"
	default 0

config AI_VOX3_BAT_ADC_GPIO
	int "Battery ADC GPIO"
	default 18

endmenu

endif # ARCH_BOARD_CUSTOM
