# =============================================================================
# AI-VOX3 (emakefun) — Config: audio
# nsh + ES8311 audio codec (I2C config + I2S data) + I2S driver
# Board: ESP32-S3-R8, 16MB Flash, 8MB OPI PSRAM
# =============================================================================

CONFIG_ARCH="xtensa"
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y

CONFIG_ARCH_BOARD="ai_vox3"
CONFIG_ARCH_BOARD_AI_VOX3=y

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_FLASH_16M=y
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_SPIRAM_SPEED_80M=y

# --- Console: native USB-CDC -------------------------------------------------
CONFIG_ESP32S3_USBSERIAL=y
CONFIG_ESP32S3_CDCACM=y
CONFIG_CDCACM=y
CONFIG_CDCACM_CONSOLE=y
CONFIG_UART0_SERIAL_CONSOLE=n
# TODO(real-device): verify USB-CDC console on the real board.

# --- Audio: ES8311 + I2S -----------------------------------------------------
CONFIG_AUDIO=y
CONFIG_AUDIO_I2S=y
CONFIG_ESP32S3_I2S=y
# The ES8311 codec NuttX driver symbol is TBD in this tree. esp32s3-eye uses
# the IDF `esp_codec_dev` component; AI-VOX3 uses the ES8311 directly.
# TODO(real-device): confirm the exact Kconfig symbol in menuconfig and enable:
#   CONFIG_AUDIO_ES8311=y            (or CONFIG_AUDIO_ESP32S3_ES8311, etc.)
# I2S pin binding (MCLK=11, BCLK=10) is fixed; the three data pins are
# ambiguous in the vendor docs and MUST be oscilloscope-verified on real HW:
#   WS/LRCK = 9 or 8 ; DOUT(ASDOUT) = 8 or 7 ; DIN(DSDIN) = 7 or 9
# See src/ai_vox3_audio.c for the centralized macros + TODO.
CONFIG_EXAMPLES_AUDIO=y

# --- NSH base ----------------------------------------------------------------
CONFIG_BOARDCTL=y
CONFIG_BUILTIN=y
CONFIG_FS_PROCFS=y
CONFIG_FS_PROCFS_REGISTER=y
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILE_APPS=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_ROMFSETC=y
CONFIG_NSH_ROMFSRC=y
CONFIG_NSH_SCRIPT=y
CONFIG_SYSTEM_NSH=y
CONFIG_EXAMPLES_NSH=y

CONFIG_SCHED_WAITPID=y
CONFIG_RR_INTERVAL=200

CONFIG_START_YEAR=2026
CONFIG_START_MONTH=1
CONFIG_START_DAY=1
