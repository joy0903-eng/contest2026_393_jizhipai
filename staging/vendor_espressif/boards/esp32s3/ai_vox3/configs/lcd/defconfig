# =============================================================================
# AI-VOX3 (emakefun) — Config: lcd
# nsh + ST7789 (240x240) over FSPI + LVGL framebuffer UI
# Board: ESP32-S3-R8, 16MB Flash, 8MB OPI PSRAM
# =============================================================================

CONFIG_ARCH="xtensa"
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y

CONFIG_ARCH_BOARD="ai_vox3"
CONFIG_ARCH_BOARD_AI_VOX3=y

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_FLASH_16M=y
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_SPIRAM_SPEED_80M=y

# --- Console: native USB-CDC -------------------------------------------------
CONFIG_ESP32S3_USBSERIAL=y
CONFIG_ESP32S3_CDCACM=y
CONFIG_CDCACM=y
CONFIG_CDCACM_CONSOLE=y
CONFIG_UART0_SERIAL_CONSOLE=n
# TODO(real-device): verify USB-CDC console on the real board.

# --- LCD: ST7789 240x240 (FSPI) ---------------------------------------------
CONFIG_LCD=y
CONFIG_LCD_ST7789=y
CONFIG_LCD_FRAMEBUFFER=y
CONFIG_LCD_FB=y
CONFIG_LCD_PORTRAIT=y
# SPI LCD pin assignment (set in menuconfig -> ESP32-S3 SPI LCD):
#   MOSI=21, SCL=17, DC=14, CS=15, BL=16, RST=-1
# TODO(real-device): confirm color order (RGB vs BGR) and rotation on real LCD.
CONFIG_GRAPHICS_LVGL=y
CONFIG_LVGL_COLOR_DEPTH=16
CONFIG_LVGL_BUFFER_ALLOC_EXTERNAL=y
CONFIG_LVGL_USE_DEMO_WIDGETS=y
CONFIG_EXAMPLES_LVGLDEMO=y
CONFIG_EXAMPLES_FB=y

# --- NSH base ----------------------------------------------------------------
CONFIG_BOARDCTL=y
CONFIG_BUILTIN=y
CONFIG_FS_PROCFS=y
CONFIG_FS_PROCFS_REGISTER=y
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILE_APPS=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_ROMFSETC=y
CONFIG_NSH_ROMFSRC=y
CONFIG_NSH_SCRIPT=y
CONFIG_SYSTEM_NSH=y
CONFIG_EXAMPLES_NSH=y

CONFIG_SCHED_WAITPID=y
CONFIG_RR_INTERVAL=200

CONFIG_START_YEAR=2026
CONFIG_START_MONTH=1
CONFIG_START_DAY=1
