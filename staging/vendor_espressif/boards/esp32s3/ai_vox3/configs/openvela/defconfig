# =============================================================================
# AI-VOX3 (emakefun) — Config: openvela  (INTEGRATED FULL FEATURE)
# nsh + USB-CDC + LCD/LVGL + ES8311/I2S + Wi-Fi/NTP + desktop_companion app
# Board: ESP32-S3-R8, 16MB Flash, 8MB OPI PSRAM
#
# This is the final product config. It enables CONFIG_EXAMPLES_DESKTOP_COMPANION
# (the AI-VOX3 desktop companion application under apps/examples/desktop_companion).
# =============================================================================

# CONFIG_ARCH_XTENSA=y is the MANDATORY choice-entry symbol (matches official
# esp32s3-eye defconfig). CONFIG_ARCH="xtensa" alone is a derived string and is
# IGNORED by olddefconfig -> without the choice entry the arch falls back to
# arm/stm32 and the build dies with "gcc: unrecognized -mlongcalls" (run#20).
CONFIG_ARCH_XTENSA=y
CONFIG_ARCH="xtensa"
CONFIG_ARCH_CHIP="esp32s3"
CONFIG_ARCH_CHIP_ESP32S3=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y

# NOTE: CONFIG_ARCH_BOARD_COMMON is deliberately NOT set.  OpenVela's
# tools/Directories.mk resolves BOARD_COMMON_DIR to "$(BOARD_DIR)/../common"
# when this is set, i.e. vendor/espressif/boards/esp32s3/common -- a directory
# that does NOT exist in the vendor tree (run#25 proof: the build log shows
# "LN: arch/xtensa/src/board to .../ai_vox3/../common", a dangling symlink,
# followed by "make[1]: *** No rule to make target 'libboard.a'").  With the
# symbol unset, tools/Unix.mk takes the else branch and links
# arch/xtensa/src/board directly to our src/, which now ships its own
# standard board Makefile (see ../src/Makefile).
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/espressif/boards/esp32s3/ai_vox3"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="ai_vox3"

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_FLASH_16M=y

# --- run#52 BISECT: OCTAL PSRAM OFF ------------------------------------------
# 2026-09-17 real-device evidence chain: run#50 and run#51 both boot to a
# totally dark LCD (no backlight => board bringup never ran) and COM4 prints
# ZERO bytes for hours; a full-system USB enumeration shows ONLY COM4
# (303A:1001 USB-Serial/JTAG) and never any new CDC port, so NuttX never
# reached OTG/USB-console init either.
#
# Remaining suspects are the two big steps that run BEFORE the console can
# possibly come up:
#   (a) OCTAL PSRAM early initialisation (arch chip init, pre-console), and
#   (b) the 2nd-stage IDF bootloader failing to load/jump.
# run#51 already dropped the PSRAM speed 80M -> 40M and stayed silent, so
# speed is not it; the next cheapest discriminator is to take PSRAM out of
# the picture entirely.  Keep the three symbols OFF for run#52; if the board
# lights up, PSRAM bring-up is the root cause and we re-enable it carefully
# (30M/20M, different pins) as a follow-up.  If the board is STILL dark but
# the patched bootloader now prints on COM4, PSRAM is exonerated and we look
# at the bootloader/app load path instead.
# CONFIG_ESP32S3_SPIRAM is not set
# CONFIG_ESP32S3_SPIRAM_MODE_OCT is not set
# CONFIG_ESP32S3_SPIRAM_SPEED_40M is not set

# --- Boot format: LEGACY IDF bootloader (run#40/#41 root cause) --------------
# Kconfig (arch/xtensa/src/esp32s3/Kconfig, verbatim): the hidden symbol
# ESPRESSIF_SIMPLE_BOOT has `default y` whenever NEITHER app format is set,
# and ESP32S3_APP_FORMAT_LEGACY defaults to `y if BUILD_PROTECTED` -- this is
# a flat build, so LEGACY resolved to n and SIMPLE_BOOT to y.  Bootloader.mk
# then took the empty-shell branch ("Using direct bootloader to boot
# NuttX.") and `make bootloader` produced NO files at all (run#40/#41
# binlist.txt forensics).  Pin LEGACY explicitly so `make bootloader` takes
# the real branch: clone esp-nuttx-bootloader, run build_idfboot.sh
# -c esp32s3 -s -f, and COPYFILE bootloader-esp32s3.bin +
# partition-table-esp32s3.bin to TOPDIR (there is NO separate
# partition_table target).  Side effects verified safe: Make.defs switches
# to legacy_sections.ld (present in the copied common/scripts), the
# partition table offset defaults to 0x8000, and no other Kconfig symbol
# depends on SIMPLE_BOOT.
CONFIG_ESP32S3_APP_FORMAT_LEGACY=y

# SMP: ESP32-S3 is dual-core; matches the official esp32s3-eye defconfig.
# (Attribution note: the esp-hal-3rdparty clk_ctrl_os.c "invalid initializer"
# error was NOT caused by missing SMP -- OpenVela's spinlock_t is a struct in
# every branch of spinlock_type.h, so the HAL's "= 0" init is invalid either
# way. That is fixed by the HAL pre-seed patch step in build.yml. SMP stays
# enabled for correct dual-core semantics and official-board parity.)
CONFIG_SMP=y
CONFIG_SMP_NCPUS=2

# --- Console: native USB-Serial/JTAG -----------------------------------------
# 2026-09-17 real-device forensics (run#50 silent on COM4): (a) CONFIG_ESP32S3_
# CDCACM does NOT EXIST in this fork's esp32s3 Kconfig (ghost symbol, silently
# dropped by olddefconfig); (b) CONFIG_CDCACM_CONSOLE belongs to the TinyUSB/
# OTG CDC-ACM path and requires CONFIG_ESP32S3_OTG + USBDEV, never enabled ->
# the console never attached at all.  The USB-Serial/JTAG hardware peripheral
# is served by CONFIG_ESP32S3_USBSERIAL, whose lower half hard-codes
# .isconsole=true -- exactly the official esp32s3-eye pattern (their nsh
# defconfig sets ONLY ESP32S3_USBSERIAL=y for the console).  Keep USBSERIAL,
# drop the ghost/broken trio.  UART0 console stays OFF: GPIO43/44 carry the
# servo PWM (LEDC channel1/2 pins 43/44).
CONFIG_ESP32S3_USBSERIAL=y
CONFIG_UART0_SERIAL_CONSOLE=n

# --- LCD: ST7789 240x240 (FSPI) + LVGL --------------------------------------
CONFIG_LCD=y
CONFIG_LCD_ST7789=y
# drivers/lcd/st7789.c #errors out without SPI command/data mode (run#21).
CONFIG_SPI=y
CONFIG_SPI_CMDDATA=y
CONFIG_LCD_FRAMEBUFFER=y
CONFIG_LCD_FB=y
CONFIG_LCD_PORTRAIT=y
# TODO(real-device): confirm ST7789 color order (RGB/BGR) & rotation.
CONFIG_GRAPHICS_LVGL=y
CONFIG_LVGL_COLOR_DEPTH=16
# run#52: PSRAM is off for the bisect (see the PSRAM block above), so LVGL must
# NOT try to allocate its draw buffers from external RAM -- the allocation
# would fail and could itself hang/crash the UI bringup, muddying the result.
# CONFIG_LVGL_BUFFER_ALLOC_EXTERNAL is not set
CONFIG_LVGL_USE_DEMO_WIDGETS=y
CONFIG_EXAMPLES_LVGLDEMO=y
CONFIG_EXAMPLES_FB=y

# --- Audio: ES8311 + I2S -----------------------------------------------------
CONFIG_AUDIO=y
# drivers/audio/Kconfig nests EVERY codec driver (incl. AUDIO_ES8311 and
# AUDIO_I2S) inside "if DRIVERS_AUDIO".  Without this umbrella symbol
# olddefconfig silently drops AUDIO_ES8311/AUDIO_I2S and es8311.h compiles
# empty -> run#29 "g_es8311_lower has initializer but incomplete type".
CONFIG_DRIVERS_AUDIO=y
# es8311.h #errors without the GENERIC I2C/I2S frameworks (the chip-level
# ESP32S3_I2C/ESP32S3_I2S symbols do not satisfy these checks):
#   CONFIG_AUDIO + CONFIG_I2S + CONFIG_I2C + CONFIG_SCHED_WORKQUEUE.
CONFIG_I2C=y
CONFIG_I2S=y
CONFIG_AUDIO_I2S=y
CONFIG_ESP32S3_I2S=y
# TODO(real-device): verify I2S WS/DOUT/DIN pins on real HW (see src/ai_vox3_audio.c).
CONFIG_EXAMPLES_AUDIO=y

# FSPI (SPI2) bus pins for the LCD -- the ESP32-S3 SPI driver routes these
# pins itself from the Kconfig values (official esp32s3-box pattern; the
# manual GPIO-matrix routing in board code was unnecessary and used
# nonexistent signal names -> run#28 errors).
CONFIG_ESP32S3_SPI2=y
CONFIG_ESP32S3_SPI2_CLKPIN=17
CONFIG_ESP32S3_SPI2_MOSIPIN=21
CONFIG_ESP32S3_SPI2_MISOPIN=-1
CONFIG_ESP32S3_SPI2_CSPIN=15

# I2C0 for the ES8311 -- pins likewise routed by the I2C driver itself.
# CONFIG_ESP32S3_I2C0 also makes esp32s3_i2cbus_initialize() exist (the
# prototype is gated by CONFIG_ESPRESSIF_I2C_PERIPH_MASTER_MODE).
CONFIG_ESP32S3_I2C=y
CONFIG_ESP32S3_I2C0=y
CONFIG_ESP32S3_I2C0_SCLPIN=12
CONFIG_ESP32S3_I2C0_SDAPIN=13
# ESPRESSIF_I2C_PERIPH_MASTER_MODE is a HIDDEN bool gated by
# (ESP32S3_I2C0_MASTER_MODE || ESP32S3_I2C1_MASTER_MODE) in the arch
# Kconfig -- a defconfig line for the hidden symbol alone is unreliable.
# The user-facing gate is the per-port master-mode switch:
CONFIG_ESP32S3_I2C0_MASTER_MODE=y
CONFIG_ESP32S3_I2C_PERIPH_MASTER_MODE=y

# ES8311 codec driver.  include/nuttx/audio/es8311.h hides every prototype
# behind CONFIG_AUDIO_ES8311 (run#28: implicit es8311_initialize despite the
# include) and #errors without AUDIO/I2S/I2C/SCHED_WORKQUEUE.
CONFIG_AUDIO_ES8311=y
CONFIG_SCHED_WORKQUEUE=y

# --- Wi-Fi + network stack ---------------------------------------------------
CONFIG_ESP32S3_WIFI=y
CONFIG_ESP32S3_WIFI_SAVE_PARAM=y
CONFIG_ESP32S3_WIFI_STATION=y

CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_IPv4=y
CONFIG_NET_ICMP=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_ARP=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NETDB_DNS=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETUTILS_DHCPC=y
CONFIG_NETUTILS_DNS=y
CONFIG_NETUTILS_NTPCLIENT=y
CONFIG_NETUTILS_WEBCLIENT=y
CONFIG_WIRELESS_WAPI=y
CONFIG_SYSTEM_WPA_NAMES=y
CONFIG_NSH_NETINIT=y
CONFIG_NSH_NETINIT_WAPI=y

# --- Servo: LEDC PWM, one timer + one channel per servo ---------------------
# Servo id i -> timer i -> channel i; GPIOs routed by the chip driver from
# the CHANNELx_PIN values (42/43/44/48 = board.h BOARD_SERVO0..3_GPIO).
CONFIG_AI_VOX3_SERVO=y
CONFIG_ESP32S3_LEDC=y
CONFIG_ESP32S3_LEDC_TIM0=y
CONFIG_ESP32S3_LEDC_TIM0_CHANNELS=1
CONFIG_ESP32S3_LEDC_TIM1=y
CONFIG_ESP32S3_LEDC_TIM1_CHANNELS=1
CONFIG_ESP32S3_LEDC_TIM2=y
CONFIG_ESP32S3_LEDC_TIM2_CHANNELS=1
CONFIG_ESP32S3_LEDC_TIM3=y
CONFIG_ESP32S3_LEDC_TIM3_CHANNELS=1
CONFIG_ESP32S3_LEDC_CHANNEL0_PIN=42
CONFIG_ESP32S3_LEDC_CHANNEL1_PIN=43
CONFIG_ESP32S3_LEDC_CHANNEL2_PIN=44
CONFIG_ESP32S3_LEDC_CHANNEL3_PIN=48

# --- Buttons: GPIO interrupts -----------------------------------------------
CONFIG_AI_VOX3_BUTTONS=y
CONFIG_ESP32S3_GPIO_IRQ=y

# --- Force nxmutex inline path (run#31 link fix) -----------------------------
# include/nuttx/mutex.h: with CONFIG_LIBC_SEM_MUTEX_NOINLINE=y every
# nxmutex_* call compiles to an extern reference whose implementation lives
# in libcc.a -- run#31 showed es8311.o (libdrivers.a) failing to resolve it
# at link time.  With the symbol off the whole tree uses the self-contained
# static-inline path in the header and the reference disappears.
# This symbol defaults to DEFAULT_SMALL, so it MUST be pinned off here.
# CONFIG_LIBC_SEM_MUTEX_NOINLINE is not set

# --- TLS task-local storage (run#32 link fix A) ------------------------------
# libs/libc/tls builds task_tls.c (task_tls_alloc/get_value/set_value) ONLY
# when CONFIG_TLS_TASK_NELEM != 0 (libs/libc/tls/Kconfig: int, default 0,
# range 0-255).  With it left at 0, esp32s3_wifi_adapter.o -- first linked
# in run#32 once board.c started calling esp32s3_wlan_sta_initialize() --
# carries undefined task_tls_* references that no library resolves.
# 8 slots is the common upstream value.
CONFIG_TLS_TASK_NELEM=8

# --- Application: desktop_companion ------------------------------------------
CONFIG_BUILTIN=y
CONFIG_EXAMPLES_DESKTOP_COMPANION=y
# LLM API key is injected at build time only (Kconfig string / NVS).
# NEVER put a plaintext secret here. The value below is intentionally empty.
CONFIG_AIVOX3_LLM_API_KEY=""
# TODO(real-device/build): provide the real key via `make menuconfig` or an
# NVS injected value; the build must NOT commit the secret to git.

# --- NSH base ----------------------------------------------------------------
CONFIG_BOARDCTL=y
CONFIG_FS_PROCFS=y
CONFIG_FS_PROCFS_REGISTER=y
# 2026-09-17 real-device forensics: with INIT_ENTRYPOINT=nsh_main the board
# boots to the NSH shell and NOTHING ever starts desktop_companion -- the LCD
# shows a dark screen (panel init ran via board_app_initialize, but no app
# ever draws). The Arduino bootloader also REJECTED the nuttx image
# ("Image requires efuse blk rev ... / No bootable app partitions") -> the
# original "black screen" was a bootloop, not a display failure. The CI
# bootloader chain loads NuttX silently. Auto-start the app as the init task
# (main.c is a while(1) loop, never returns):
CONFIG_INIT_ENTRYPOINT="desktop_companion_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILE_APPS=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_ROMFSETC=y
CONFIG_NSH_ROMFSRC=y
CONFIG_NSH_SCRIPT=y
CONFIG_SYSTEM_NSH=y
CONFIG_EXAMPLES_NSH=y

CONFIG_SCHED_WAITPID=y
CONFIG_RR_INTERVAL=200

CONFIG_START_YEAR=2026
CONFIG_START_MONTH=1
CONFIG_START_DAY=1
