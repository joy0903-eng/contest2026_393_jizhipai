# --- Wi-Fi station credentials ---------------------------------------------
# Used by net_services.c:net_init() -> net_wifi_connect().  WPA2-PSK.
# Same convention as the LLM key above: build-time config, never a literal in
# a .c file.  Empty => net_init() fails fast with a syslog reason (no hang).
CONFIG_AIVOX3_WIFI_SSID="3124"
CONFIG_AIVOX3_WIFI_PASSWORD="rczzzhr312"

# --- PC voice bridge ---------------------------------------------------------
# Host running toolchain/voice_bridge/bridge_chat.py.  Home routers hand out
# DHCP leases, so this WILL go stale -- override at runtime from the USB-CDC
# console with:  bridge 192.168.1.42 8765
CONFIG_AIVOX3_BRIDGE_HOST="192.168.110.205"
CONFIG_AIVOX3_BRIDGE_PORT=8765
# Socket inactivity timeout.  A measured turn is 8.3 s (real speech) to
# 18.2 s (text); the bridge's own LLM timeout is (5,40).  60 s is safe.
CONFIG_AIVOX3_BRIDGE_TIMEOUT=60

# --- NSH base ----------------------------------------------------------------
CONFIG_BOARDCTL=y
CONFIG_FS_PROCFS=y
CONFIG_FS_PROCFS_REGISTER=y
# 2026-09-17 real-device forensics: with INIT_ENTRYPOINT=nsh_main the board
# boots to the NSH shell and NOTHING ever starts desktop_companion -- the LCD
# shows a dark screen (panel init ran via board_app_initialize, but no app
# ever draws). The Arduino bootloader also REJECTED the nuttx image
# ("Image requires efuse blk rev ... / No bootable app partitions") -> the
# original "black screen" was a bootloop, not a display failure. The CI
# bootloader chain loads NuttX silently. Auto-start the app as the init task
