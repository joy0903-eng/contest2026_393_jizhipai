############################################################################
# vendor/espressif/boards/esp32s3/ai_vox3/src/Make.defs
#
# SPDX-License-Identifier: Apache-2.0
#
# Board source list for emakefun AI-VOX3 (ESP32-S3-R8).
# Follows the OpenVela vendor-board convention (see esp32s3-eye):
# sources are declared here; the unified board build template compiles
# them into libboard.a.
#
############################################################################

include $(TOPDIR)/Make.defs

CSRCS = board.c

# run#32 link fix: unconditional nxmutex symbol provider.  Some member
# objects pulled into the link (es8311.o under drivers/audio) carry
# extern references to nxmutex_init/lock/unlock even with
# CONFIG_LIBC_SEM_MUTEX_NOINLINE off.  ai_vox3_mutex_shim.c re-includes
# mutex.h/semaphore.h with the NOINLINE magic applied, emitting global
# definitions into libboard.a; libboards links AFTER libdrivers in
# tools/FlatLibs.mk NUTTXLIBS, so these resolve the references.  Safe:
# with NOINLINE pinned off, libc.a's own noinline TU compiles empty
# (no duplicate symbols) -- see the shim's header comment for the full
# argument.
CSRCS += ai_vox3_mutex_shim.c

ifeq ($(CONFIG_LCD_ST7789),y)
CSRCS += ai_vox3_lcd.c
endif

ifeq ($(CONFIG_ESP32S3_I2S),y)
CSRCS += ai_vox3_audio.c
endif

ifeq ($(CONFIG_AI_VOX3_SERVO),y)
CSRCS += ai_vox3_servo.c
endif

ifeq ($(CONFIG_AI_VOX3_WS2812),y)
CSRCS += ai_vox3_ws2812.c
endif

ifeq ($(CONFIG_AI_VOX3_BUTTONS),y)
CSRCS += ai_vox3_buttons.c
endif

ifeq ($(CONFIG_MMCSD),y)
CSRCS += ai_vox3_sd.c
endif

# Register the board source directory with the common build
VPATH += :board
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)board

# run#62: ai_vox3_ws2812.c calls esp_rmt_tx_init(), which is declared in
# arch/xtensa/src/common/espressif/esp_rmt.h.  That header lives in the arch
# common/espressif directory, and NOTHING puts that directory on the include
# path for a board driver:
#   - arch/xtensa/src/common/espressif/Make.defs adds only its
#     "platform_include" SUBdirectory (see its INCLUDES line), not itself;
#   - the board's own include path above is arch/.../src/board/board only.
# Without this line the compiler reports
#   "implicit declaration of function 'esp_rmt_tx_init'"
# which still compiles under implicit-int rules and fails later at link time,
# looking unrelated to the real cause.
#
# run#65 follow-up: the first attempt at this line used $(ARCH_SRCDIR), which
# is the idiom arch/xtensa/src/common/espressif/Make.defs uses for ITSELF.
# That variable is EMPTY in a board Make.defs -- board Make.defs is evaluated
# before arch Make.defs, so the expansion silently degenerated to the absolute
# path "/common/espressif" and GCC ignored it.  Proven from run#65's own
# command line dump:
#     '-I' '/common/espressif'   <- ours, a directory that does not exist
#     '-I' '.../nuttx/arch/xtensa/src/common'   <- upstream's, correct
# A wrong -I is SILENT: no warning, no error, just an include that cannot be
# found later.  So spell the path out with the exact same variables the line
# above uses ($(TOPDIR)/$(CONFIG_ARCH)) -- those are board-context safe, as
# the pre-existing board include path already proves.
ifeq ($(CONFIG_ESP_RMT),y)
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)common$(DELIM)espressif
endif

# Board-local headers ("board.h" lives in the board include/ directory).
# BOARD_COMMON_DIR is empty when CONFIG_ARCH_BOARD_COMMON is unset (our case,
# see configs/openvela/defconfig) -- guard against expanding to "-I/include".
ifneq ($(BOARD_COMMON_DIR),)
CFLAGS += ${INCDIR_PREFIX}$(BOARD_COMMON_DIR)$(DELIM)include
endif
